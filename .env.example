# ==============================================================================
# GhostHand Configuration - Vercel AI Gateway & Jev Model
# ==============================================================================

# [REQUIRED] Your Vercel AI Gateway API Key
# Generated from 'npx vercel ai-gateway setup' or copied from:
# https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# [OPTIONAL] AI Gateway Endpoint & Model Configuration
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev

# [OPTIONAL] Privacy & Data Retention
# Code reads ZERO_DATA_RETENTION (not AI_GATEWAY_ZERO_DATA_RETENTION).
# When true, passes providerOptions.gateway.zeroDataRetention = true
ZERO_DATA_RETENTION=false

# [OPTIONAL] Model Decision Thresholds
# Minimum confidence for an action to be executed. 0.0 disables the gate
# (Jarvis default: never ask the human). Any value > 0 makes the agent fall
# back to "ask_user" instead of guessing when the model is unsure.
DECISION_CONFIDENCE_THRESHOLD=0.0
# Reserved for the risk-escalation path (currently unused by Jarvis-mode policy).
RISK_CONFIDENCE_THRESHOLD=0.70

# [OPTIONAL] Execution Mode & Limits
# Set to 'false' to allow GhostHand to click and type on real windows
# Set to 'true' to simulate and print actions only
DRY_RUN=true
# 0 = unlimited (run until the task completes or is cancelled)
MAX_STEPS_PER_RUN=30

# [OPTIONAL] Test Gating
# Set to 1 to enable live integration tests that call Vercel AI Gateway
JEV_LIVE_TESTS=0
