<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The hardened runtime (required for notarisation) blocks microphone access unless the
      binary carries this entitlement. GhostHand only uses audio input for optional voice
      commands, but without it the app crashes when the speech path is exercised.
      If Speech recognition is additionally denied at runtime, add
      com.apple.security.personal-information.speech-recognition here.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
