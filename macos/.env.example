# ==============================================================================
# GhostHand (macOS) Configuration - local Laya decision model
# ==============================================================================
# Laya runs on this machine; no API key or network access is required by default.
# A .env file next to the binary (or in the current directory) is read automatically.

# [OPTIONAL] Local Laya server
LAYA_BASE_URL=http://127.0.0.1:8000
# Force a checkpoint: english | multilingual | typed-decisions
# Leave empty to let Laya route by language (recommended).
LAYA_MODEL=

# [OPTIONAL] Bearer token, only if the server sets LAYA_API_KEY
LAYA_API_KEY=

# [OPTIONAL] Start the server automatically when nothing is listening
LAYA_AUTOSTART=true
LAYA_STARTUP_TIMEOUT_SECONDS=240

# [OPTIONAL] Local install locations (auto-detected when empty)
LAYA_PYTHON=
# Point these at your own Laya checkout (auto-detected when empty).
LAYA_HOME=
LAYA_MODELS_ROOT=
LAYA_SERVE_SCRIPT=

# [OPTIONAL] Inference device and threading
LAYA_DEVICE=cpu
LAYA_THREADS=16

# [OPTIONAL] Token budgets and choice-option cap
LAYA_MAX_LEN=4096
LAYA_HEAD_MAX_LEN=2048
LAYA_MAX_CHOICE_OPTIONS=90
# 0.0 disables the confidence gate (Jarvis default: never ask the human).
LAYA_MIN_CONFIDENCE=0.0
LAYA_TIMEOUT_SECONDS=120

# [OPTIONAL] Execution mode & limits
# Set to 'false' to allow GhostHand to click and type on real windows.
DRY_RUN=true
# 0 = unlimited (run until the task completes or is cancelled)
MAX_STEPS_PER_RUN=30
